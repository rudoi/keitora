{
  "name": "keitora",
  "private": true,
  "license": "MIT",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:isolated": "node scripts/dev-herdr.mjs",
    "dev:herdr": "node scripts/dev-herdr.mjs",
    "build": "tsc && vite build",
    "bundle-cli": "node scripts/stage-sidecars.mjs",
    "tauri:bundle": "yarn bundle-cli && tauri build --config src-tauri/tauri.bundle.conf.json",
    "release": "tsx scripts/release.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "husky",
    "lint": "biome check src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "*.rs": "rustfmt --edition 2021"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9",
    "lint-staged": "^15",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.0"
  }
}
